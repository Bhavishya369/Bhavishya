# Push server environment variables
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
# Use either FIREBASE_SERVICE_ACCOUNT_BASE64 or FIREBASE_SERVICE_ACCOUNT_PATH
FIREBASE_SERVICE_ACCOUNT_PATH=../path/to/service-account.json
#FIREBASE_SERVICE_ACCOUNT_BASE64=BASE64_ENCODED_SERVICE_ACCOUNT_JSON
ADMIN_API_KEY=change-me
NOTIFICATION_ICON_URL=https://your-site.com/notification-icon.png
# Optional: override chat path, default is /chat
# CHAT_DB_PATH=/chat
# Optional: process PORT override
# PORT=3000
